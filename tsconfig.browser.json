{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "rewriteRelativeImportExtensions": true,
    "lib": ["ES2020", "DOM"],
    "outDir": "dist/browser",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/parser.ts", "src/tategaki.ts"],
  "exclude": ["node_modules", "dist"]
}
