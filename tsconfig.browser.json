{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "rewriteRelativeImportExtensions": true,
    "lib": ["ES2020", "DOM"],
    "outDir": "dist/browser",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "src/parser.ts",
    "src/tategaki.ts",
    "src/kanjiData.ts",
    "src/questionStore.ts",
    "src/learnedKanjiStore.ts",
    "src/settingsStore.ts",
    "src/testHistoryStore.ts",
    "src/testGenerator.ts",
    "src/pdfExport.ts",
    "src/kanjiReadings.ts",
    "src/furigana.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
